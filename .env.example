# Copy to .env and edit. Every setting is optional except TRMNL_WEBHOOK_URL (push mode).

# Webhook URL from your TRMNL private plugin (Strategy: Webhook).
TRMNL_WEBHOOK_URL=https://trmnl.com/api/custom_plugins/your-plugin-uuid

# Where tar1090 lives. aircraft.json and receiver.json are read from $TAR1090_URL/data/.
TAR1090_URL=http://localhost/tar1090
# Or point straight at readsb's output files / other URLs:
# AIRCRAFT_JSON=/run/readsb/aircraft.json
# RECEIVER_JSON=/run/readsb/receiver.json

# Receiver location. Leave unset to use the location in receiver.json.
# RECEIVER_LAT=32.8998
# RECEIVER_LON=-97.0403

# Search radius, in DISTANCE_UNIT (mi, nm or km).
RADIUS=25
DISTANCE_UNIT=mi

# 1 = prefer large aircraft (ADS-B categories A3-A5) over light aircraft/helicopters.
PREFER_AIRLINERS=1

# Ignore aircraft whose position is older than this many seconds.
MAX_POSITION_AGE=60

# Seconds between webhook pushes. TRMNL allows 12/hour (30/hour on TRMNL+),
# so keep this at 300 or higher (120 with TRMNL+).
PUSH_INTERVAL=300

# serve mode only
# HOST=0.0.0.0
# PORT=5000
