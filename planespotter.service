# systemd unit for pushing the closest aircraft to TRMNL.
# Install: see README.md ("Run it on boot").
[Unit]
Description=TRMNL Planespotter (tar1090 -> TRMNL webhook)
After=network-online.target tar1090.service readsb.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/trmnl-planespotter
ExecStart=/home/pi/trmnl-planespotter/.venv/bin/python planespotter.py push
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
